{
  "name": "portleaf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/launch.mjs",
    "build": "pnpm check && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/validate.mjs all",
    "test:unit": "node scripts/validate.mjs unit",
    "test:integration": "node scripts/validate.mjs integration",
    "test:e2e": "pnpm build && xvfb-run -a -s '-screen 0 1280x900x24' node scripts/validate.mjs e2e",
    "test:e2e:existing": "xvfb-run -a -s '-screen 0 1280x900x24' node scripts/validate.mjs e2e",
    "package": "pnpm build && node scripts/package.mjs",
    "package:existing": "node scripts/package.mjs",
    "recover": "node scripts/recover.mjs",
    "format": "prettier --write apps packages scripts tests docs .github *.json *.ts *.yaml README.md",
    "format:check": "prettier --check apps packages scripts tests docs .github *.json *.ts *.yaml README.md",
    "bench": "pnpm build && xvfb-run -a -s '-screen 0 1280x900x24' node scripts/benchmark.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/write-file-atomic": "^4.0.3",
    "electron": "43.8.3",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.6"
  }
}
